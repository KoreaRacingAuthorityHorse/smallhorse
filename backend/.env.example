# backend/ 안에서 이 파일을 복사해 .env 로 만든 뒤 값을 채운다. (.env 는 git 에 올라가지 않음)
# docker compose(backend/docker-compose.yml)와 Spring 백엔드가 같은 .env 를 읽는다.
# 값 주변에 따옴표/공백을 넣지 말 것.  예) KEY=value

# ---- DB (docker compose 와 백엔드가 같이 사용, 기본값이면 수정 불필요) ----
DB_NAME=smallhorse
DB_USER=smallhorse
DB_PASSWORD=smallhorse
DB_PORT=5432

# ---- Google OAuth (필수: 구글 콘솔에서 발급한 값) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 선택: 필요할 때만 주석(#)을 풀고 값을 넣는다. 빈 값으로 두면 안 됨 ----
# 배포 서버에서는 반드시 32바이트 이상 임의 값으로 설정
# SMALLHORSE_JWT_SECRET=
# 프론트 주소 (기본 http://localhost:3000)
# FRONTEND_URL=
# https 로 배포할 때 true
# JWT_COOKIE_SECURE=false
